<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <MelonDir Condition="'$(MelonDir)' == ''">$(MSBuildThisFileDirectory)..\..\out\melonloader-0.7.3\package\MelonLoader\net6</MelonDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Tomlet" HintPath="$(MelonDir)\Tomlet.dll" />
  </ItemGroup>
</Project>
